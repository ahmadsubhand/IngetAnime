# All variables are required

# Application
PORT=4000 # Backend server port
NODE_ENV=development # Application environment: development or production
CLIENT_URL=http://localhost:3000 # Frontend application URL
CSRF_SECRET="your-csrf-secret" # Secret key for CSRF token protection

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/ingetanime" # PostgreSQL connection URL

# JWT
JWT_SECRET="your-jwt-secret" # Secret key for signing and verifying JWTs
JWT_EXPIRATION="28d" # JWT expiration duration (e.g., 28d)

# Mailer
MAILER_USER="your-email@example.com" # Email account used to send emails
MAILER_PASSWORD="your-email-app-password" # App password of email acount

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id" # Google OAuth client ID
GOOGLE_CLIENT_SECRET="your-google-client-secret" # Google OAuth client secret

# MyAnimeList (MAL) OAuth
MAL_CLIENT_ID="your-mal-client-id" # MyAnimeList OAuth client ID
MAL_CLIENT_SECRET="your-mal-client-secret" # MyAnimeList OAuth client secret